# deepsearch 环境配置示例 —— 复制为 .env 后填入真实密钥(勿提交 .env)

# ---- 应用 ----
DATA_DIR=data
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---- 租户/用户(单机自用保持默认) ----
TENANT_ID=default
USER_ID=owner

# ---- 主模型档(DeepSeek) ----
PRIMARY_BASE_URL=https://api.deepseek.com/v1
PRIMARY_API_KEY=sk-your-deepseek-key
PRIMARY_MODEL=deepseek-chat

# ---- 廉价档(Qwen,Dashscope OpenAI 兼容端点) ----
UTILITY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UTILITY_API_KEY=sk-your-dashscope-key
UTILITY_MODEL=qwen-turbo

# ---- Embedding(Dashscope text-embedding-v3,可与廉价档同 key) ----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---- 存储三域(由使用者自备实例) ----
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379/0
POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/deepsearch
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# ---- 检索供应商 ----
BOCHA_API_KEY=your-bocha-key
TAVILY_API_KEY=tvly-your-tavily-key

# ---- 成本护栏与写作参数(可留默认) ----
COST_LIMIT_CNY_PER_REPORT=5.0
# MINERU_API_URL=http://127.0.0.1:8002
# UPLOAD_MAX_MB=40
